	measure 'Factor Amount' =
			
			SWITCH(SELECTEDVALUE(ChartColumns[ColumnName]),
			"GP PM", [_1 Gross Profit Prev],
			"Volume", [Volume Factor] + 0,
			"MIX", [MIX Factor] + 0,
			"Price",[Price Factor] + 0,
			"COGS", [Cogs Factor] + 0,
			"Delisted SKUs", [Old SKU Factor] + 0,
			"New SKUs", [New SKU Factor] + 0,
			"GP Act", [_0 Gross Profit]
			)
