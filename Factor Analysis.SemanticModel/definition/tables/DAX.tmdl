	measure Subtitle =
			
			var _sel = SELECTEDVALUE('Calendar'[Month], "all")
			VAR _date = MAX('Calendar'[Date])
			VAR _act = FORMAT(_date, "mmm'yy")
			VAR _prev = FORMAT(EDATE(_date, -12), "mmm'yy")
			VAR _act_all = FORMAT(_date, "yyyy")
			VAR _prev_all = FORMAT(EDATE(_date, -12), "yyyy")
			
			RETURN IF(_sel = "all",  "Per Period: " & _act_all & " vs " & _prev_all, "Per Period: " & _act & " vs " & _prev)
