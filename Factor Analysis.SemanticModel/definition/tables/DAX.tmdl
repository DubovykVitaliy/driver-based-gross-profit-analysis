	measure 'tooltip Header' =
			
			VAR _m = FORMAT(MAX('Calendar'[Date]), "mmm")
			VAR _y = YEAR(MAX('Calendar'[Date]))
			VAR _y_p = YEAR(MAX('Calendar'[Date])) - 1
			VAR _gp = [_0 Gross Profit]
			VAR _gp_p = [_1 Gross Profit Prev]
			var _vari = _gp - _gp_p
			var _up_down = IF(_vari <0, "decreased ", IF(_vari>0, "increased ", "didn't change"))
			var _result = IF(_gp_p < 1000000, FORMAT(DIVIDE(_gp_p, 1000), "# ###.0K"  ),  FORMAT(DIVIDE(_gp_p, 1000000), "# ###.0M"  ))
			var _result_act = IF(_gp < 1000000, FORMAT(DIVIDE(_gp, 1000), "# ###.0K"  ),  FORMAT(DIVIDE(_gp, 1000000), "# ###.0M"  ))
			RETURN " from "& _result & " in " & _m & " " & _y_p & " to " & _result_act & " in " & _m & " " & _y
		displayFolder: Tooltip Waterfall
		lineageTag: 02eb2201-3ef3-4a3e-9242-203062018f8c

	measure 'tooltip body' =
			
			var _sel = SELECTEDVALUE(ChartColumns[ColumnName])
			var _am  = [Factor Amount]
			var _am_form = IF(ABS(_am) < 1000000, FORMAT(DIVIDE(ABS(_am), 1000), "# ###.0K"  ),  FORMAT(DIVIDE(ABS(_am), 1000000), "# ###.0M"  ))
			var _updown = IF(_am < 0, "reduced " , IF(_am > 0, "increased " , "didn't affect"))
			var _updown_num = IF(_am <> 0, " by " & _am_form )
			var _vol =  _updown_num
			RETURN  IF(_sel = "GP Act" || _sel = "GP PM", BLANK(), _vol)
		displayFolder: Tooltip Waterfall
		lineageTag: 587fff99-4cd9-426a-8501-e79c55564bdb

	measure 'tooltip body 2' =
			
			var _sel  = SELECTEDVALUE(ChartColumns[ColumnName])
			var _first = SWITCH(_sel,
			"Volume", "Changes in Solded Quantity",
			"Mix", "Changes in MIX of products",
			"Price", "Changes in Weighted Average Price",
			"COGS", "Changes in Weighted Average Cost of Product",
			"Delisted SKUs", "Removal products from sale",
			"New SKUs", "Adding new products")
			var _am  = [Factor Amount]
			var _am_form = IF(_am < 1000000, FORMAT(DIVIDE(ABS(_am), 1000), "# ###.0K"  ),  FORMAT(DIVIDE(ABS(_am), 1000000), "# ###.0M"  ))
			var _updown = IF(_am < 0, "reduced" , IF(_am > 0, "increased" , "didn't affect"))
			RETURN
			 IF(_sel = "GP Act" || _sel = "GP PM", BLANK(),
			 _updown & " Gross Profit Amount")
