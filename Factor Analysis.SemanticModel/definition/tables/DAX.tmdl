	measure 'MIX Factor' = ```
			
			VAR _both_periods = GetProductsWithSalesBothPeriods()
			VAR _q_prev =
			    SUMX (
			        _both_periods,
			        CALCULATE ( [_1 quantity prev], REMOVEFILTERS ( DimProduct[Product Name] ) )
			    )
			VAR _m_prev =
			    SUMX (
			        _both_periods,
			        CALCULATE ( [_1 Gross Profit Prev], REMOVEFILTERS ( DimProduct[Product Name] ) )
			    )
			VAR _q =
			    SUMX (
			        _both_periods,
			        CALCULATE ( [_0 Quantity], REMOVEFILTERS ( DimProduct[Product Name] ) )
			    )
			VAR _rate = _q / _q_prev
			VAR _profit_per_item_prev = _m_prev / _q_prev 
			
			RETURN
			    SUMX (
			        _both_periods,
			        ( [_0 Quantity] - _rate * [_1 quantity prev] )
			            * (
			                CALCULATE ( [_0 W Av Price], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
			                    - CALCULATE ( [_0 W Av Cost], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) ) - _profit_per_item_prev
			            )
			    )
			```
		formatString: #,0.00\ "₴";-#,0.00\ "₴";#,0.00\ "₴"
		displayFolder: Factors
		lineageTag: 1b48c63d-eff0-4262-998c-6f83d1aa0d0e

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '_1 cogs prev' = CALCULATE([_0 COGS], SAMEPERIODLASTYEAR('Calendar'[Date]))
		formatString: #,0.00\ "₴";-#,0.00\ "₴";#,0.00\ "₴"
		displayFolder: Base Prev Period
		lineageTag: 87c36917-29d8-41a3-9374-330af50ea84d

		annotation PBI_FormatHint = {"currencyCulture":"uk-UA"}

	measure 'Volume Factor' =
			
			VAR _both_periods = GetProductsWithSalesBothPeriods()
			VAR _q_prev =
			    SUMX (
			        _both_periods,
			        CALCULATE ( [_1 quantity prev], REMOVEFILTERS ( DimProduct[Product Name] ) )
			    )
			VAR _m_prev =
			    SUMX (
			        _both_periods,
			        CALCULATE ( [_1 Gross Profit Prev], REMOVEFILTERS ( DimProduct[Product Name] ) )
			    )
			VAR _q =
			    SUMX (
			        _both_periods,
			        CALCULATE ( [_0 Quantity], REMOVEFILTERS ( DimProduct[Product Name] ) )
			    )
			VAR _profit_per_item_prev = _m_prev / _q_prev
			RETURN
			    SUMX (
			        _both_periods,
			        ( [_0 Quantity] - [_1 quantity prev] ) * _profit_per_item_prev
			    )
		formatString: #,0.00\ "₴";-#,0.00\ "₴";#,0.00\ "₴"
		displayFolder: Factors
		lineageTag: 551e63ce-8cf5-477c-85a9-7509fb020f75

		annotation PBI_FormatHint = {"currencyCulture":"uk-UA"}

	measure 'Price Factor' =
			
			VAR _both_periods =  GetProductsWithSalesBothPeriods()
			VAR _q_prev =
			    SUMX (
			        _both_periods,
			        CALCULATE ( [_1 quantity prev], REMOVEFILTERS ( DimProduct[Product Name] ) )
			    )
			VAR _q =
			    SUMX (
			        _both_periods,
			        CALCULATE ( [_0 Quantity], REMOVEFILTERS ( DimProduct[Product Name] ) )
			    )
			RETURN
			    SUMX (
			        _both_periods,
			        [_0 Quantity]
			            * (
			                [_0 W Av Price]
			                    - CALCULATE ( [_0 W Av Price], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
			            )
			    )
		formatString: #,0.00\ "₴";-#,0.00\ "₴";#,0.00\ "₴"
		displayFolder: Factors
		lineageTag: b94a41b5-8df9-4d88-a291-b2b0cfe3e49d

		annotation PBI_FormatHint = {"currencyCulture":"uk-UA"}

	measure '_1 W Av Price prev' = CALCULATE([_0 W Av Price], SAMEPERIODLASTYEAR('Calendar'[Date]))
		formatString: #,0.00\ "₴";-#,0.00\ "₴";#,0.00\ "₴"
		displayFolder: Base Prev Period
		lineageTag: bb37eb98-2602-4e8e-a5ac-92ba1f31847e

		annotation PBI_FormatHint = {"currencyCulture":"uk-UA"}

	measure 'Cogs Factor' =
			
			VAR _both_periods = GetProductsWithSalesBothPeriods()
			VAR _q_prev =
			    SUMX (
			        _both_periods,
			        CALCULATE ( [_1 quantity prev], REMOVEFILTERS ( DimProduct[Product Name] ) )
			    )
			VAR _q =
			    SUMX (
			        _both_periods,
			        CALCULATE ( [_0 Quantity], REMOVEFILTERS ( DimProduct[Product Name] ) )
			    )
			RETURN
			    SUMX (
			        _both_periods,
			        [_0 Quantity]
			            * (
			                [_0 W Av Cost]
			                    - CALCULATE ( [_0 W Av Cost], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
			            )
			    ) * -1
		formatString: #,0.00\ "₴";-#,0.00\ "₴";#,0.00\ "₴"
		displayFolder: Factors
		lineageTag: d75e3eea-a359-4246-be7c-db32bc8d55d8

		annotation PBI_FormatHint = {"currencyCulture":"uk-UA"}

	measure 'Old SKU Factor' =
			
			VAR _cur_items =
			    CALCULATETABLE (
			        VALUES ( FactSales[ProductKey] ),
			        REMOVEFILTERS ( DimProduct[Product Name] )
			    )
			VAR _prev_items =
			    CALCULATETABLE (
			        VALUES ( FactSales[ProductKey] ),
			        REMOVEFILTERS ( DimProduct[Product Name] ),
			        SAMEPERIODLASTYEAR ( 'Calendar'[Date] )
			    )
			VAR _first_period =
			    EXCEPT ( _prev_items, _cur_items )
			VAR _mg_prev =
			    SUMX ( _first_period, [_1 Gross Profit Prev] ) * -1
			RETURN
			    _mg_prev
		formatString: #,0.00\ "₴";-#,0.00\ "₴";#,0.00\ "₴"
		displayFolder: Factors
		lineageTag: 9abc712c-41f9-42e0-bda2-9ce1f61b28e2

		annotation PBI_FormatHint = {"currencyCulture":"uk-UA"}

	measure 'New SKU Factor' =
			
			VAR _cur_items =
			    CALCULATETABLE (
			        VALUES ( FactSales[ProductKey] ),
			        REMOVEFILTERS ( DimProduct[Product Name] )
			    )
			VAR _prev_items =
			    CALCULATETABLE (
			        VALUES ( FactSales[ProductKey] ),
			        REMOVEFILTERS ( DimProduct[Product Name] ),
			        SAMEPERIODLASTYEAR ( 'Calendar'[Date] )
			    )
			VAR _cur_period =
			    EXCEPT ( _cur_items, _prev_items )
			VAR _mg_curr =
			    SUMX ( _cur_period, [_0 Gross Profit] )
			RETURN
			    _mg_curr
		formatString: #,0.00\ "₴";-#,0.00\ "₴";#,0.00\ "₴"
		displayFolder: Factors
		lineageTag: 261dbf01-6fef-48d4-93d8-51535031ba13

		annotation PBI_FormatHint = {"currencyCulture":"uk-UA"}

