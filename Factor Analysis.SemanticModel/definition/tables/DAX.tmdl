	measure 'label ref sales' =
			
			var _act = [_0 Sales]
			var _prev = [_1 Sales Prev year]
			VAR _diff = _act - _prev
			VAR _diff_pct = DIVIDE( _act, _prev) - 1
			
			var _result1 = SWITCH(TRUE()
			  , ABS(_diff) < 1000, FORMAT(_diff, "+# ###.0;-#,##0.0;0.0"  )
			  , ABS(_diff) < 1000000, FORMAT(DIVIDE(_diff, 1000), "+# ###.0K;-#,##0.0K"  )
			  , FORMAT(DIVIDE(_diff, 1000000), "+# ###.0M;-#,##0.0M"  ) )
			var _result2 =  FORMAT(_diff_pct, "0.0%"  )
			
			RETURN  _result1  & " | " & _result2 & IF(_diff < 0, " ▼", " ▲")
		displayFolder: Labels Cards\refs
		lineageTag: 2f820f1e-e6b7-486f-99d9-8e4f8143171d

