	measure DynamicMeasure = ```
			
			VAR _both_periods = GetProductsWithSalesBothPeriods()
			VAR _sales =
			    SUMX (
			        _both_periods,
			        [_0 Sales]
			    )
			VAR _quant =
			    SUMX (
			        _both_periods,
			        [_0 Quantity]
			    )
			VAR _price =
			
			       DIVIDE(_sales, _quant)
			
			VAR _cogs =
			    SUMX (
			        _both_periods,
			        [_0 COGS]
			    )
			VAR _gp =
			
			        _sales - _cogs
			
			
			RETURN 
			SWITCH(
			    SELECTEDVALUE(TableColumnLabel[SortOrder]),
			    1, _quant ,
			    2, _price,
			    3, _sales ,
			    4, _cogs,
			    5, _gp,
			    BLANK()
			)
			```
		lineageTag: fb509d7f-5eff-4bcd-83aa-8f4460583329

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure dynamicMeasureprev = ```
			
			
			VAR _both_periods = GetProductsWithSalesBothPeriods()
			VAR _sales =
			    SUMX (
			        _both_periods,
			        [_1 Sales Prev year]
			    )
			VAR _quant =
			    SUMX (
			        _both_periods,
			        [_1 quantity prev]
			    )
			VAR _price =
			        DIVIDE(_sales, _quant)
			
			VAR _cogs =
			    SUMX (
			        _both_periods,
			        [_1 cogs prev]
			    )
			VAR _gp =
			    _sales - _cogs
			
			RETURN 
			SWITCH(
			    SELECTEDVALUE(TableColumnLabel[SortOrder]),
			    1, _quant ,
			    2, _price,
			    3, _sales ,
			    4, _cogs,
			    5, _gp,
			    BLANK()
			)
			```
		formatString: #,0.###############\ "₴";-#,0.###############\ "₴";#,0.###############\ "₴"
		lineageTag: 72951c35-ffb7-477a-9de8-bb8b910c342d

		annotation PBI_FormatHint = {"currencyCulture":"uk-UA"}

	measure 'Table title' =
			
			var _sel = SELECTEDVALUE('Param Granularity level'[Parameter Order])
			var _val = SWITCH(_sel,
			0, "Category",
			1, "Subcategory",
			2, "Product")
			RETURN "Performance Metrics breakdown on " & _val & " level"
		displayFolder: Text titlles
		lineageTag: 6316bd40-cbdd-41e5-9921-f6d68bfc7330

	measure 'Title Description' = ```
			
			var _prof = [Delta Profit]
			var _gp = [_0 Gross Profit]
			var _prof_form =  IF(ABS(_prof) > 1000000, FORMAT(DIVIDE(ABS(_prof), 1000000), "# ###.0M UAH"  ),  FORMAT(DIVIDE(ABS(_prof), 1000), "# ###.0K UAH"  ))
			var _gp_form =  IF(ABS(_gp) > 1000000, FORMAT(DIVIDE(ABS(_gp), 1000000), "# ###.0M UAH"  ),  FORMAT(DIVIDE(ABS(_gp), 1000), "# ###.0K UAH"  ))
			var _pos = "This year's profit figures exceeded last year's results by "
			var _neg = "This year's profit figures are lower than last year's results by "
			var _even = "This year's profit figures are unchanged from last year. "
			var _res = " and amounted to "
			RETURN SWITCH(TRUE(),
			_prof > 0, _pos & _prof_form & _res & _gp_form,
			_prof < 0, _neg & _prof_form & _res & _gp_form,
			 _even & _res & _gp_form 
			
			)
			```
		displayFolder: Text titlles
		lineageTag: 2733e95a-188c-4197-86af-7ec516d45871

