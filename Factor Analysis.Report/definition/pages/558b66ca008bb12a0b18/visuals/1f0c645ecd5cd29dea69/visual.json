              },
              "queryRef": "select1",
              "nativeQueryRef": "Amount factors Neg"
            },
            {
              "field": {
                "NativeVisualCalculation": {
                  "Language": "dax",
                  "Expression": "IF([ColumnName] <> \"GP PM\" && [ColumnName] <> \"GP Act\" && [ColumnName] <> \"Change\" \r\n&& [Factor Amount] > 0 \r\n    , [Factor Amount])",
                  "Name": "Amount factors Pos"
