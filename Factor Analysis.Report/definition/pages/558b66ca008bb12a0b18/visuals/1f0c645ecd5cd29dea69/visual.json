                  "Expression": "SWITCH(TRUE(),\n[Dull Line] <> 0, [Running sum] - [Dull Line],\nNOT ISBLANK([Amount factors Pos]), [Running sum] - [Amount factors Pos],\nNOT ISBLANK([Amount factors Neg]), [Running sum],\n0)",
