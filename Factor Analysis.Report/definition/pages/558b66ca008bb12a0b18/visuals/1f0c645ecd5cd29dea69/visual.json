              "queryRef": "select2",
              "nativeQueryRef": "Amount factors Pos"
            },
            {
              "field": {
                "NativeVisualCalculation": {
                  "Language": "dax",
                  "Expression": "IF( COALESCE([Amount start],[Amount end],[Amount factors Neg],[Amount factors Pos]) = 0,\n MAXX(ROWS,[Factor Amount]) / 300)",
