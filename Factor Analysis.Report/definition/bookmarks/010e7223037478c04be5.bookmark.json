                      "Property": "dynamicMeasureprev"
                    }
                  },
                  {
                    "NativeVisualCalculation": {
                      "Language": "dax",
                      "Expression": "\r\nvar _act = [DynamicMeasure]\r\nvar _prev = [dynamicMeasureprev]\r\nvar _dif = _act - _prev\r\nvar _pct = DIVIDE(_act - _prev, _prev)\r\n\r\nvar _metric_level = \r\nSWITCH([Metric],\r\n\r\n\"Δ UAH\", _dif,\r\n\"Δ %\", _pct)\r\n\r\nRETURN  \r\n// _metric_level\r\nSWITCH( TRUE(),\r\nISATLEVEL([Metric]), _metric_level \r\n)",
                      "Name": "Calc Value"
                    }
                  },
                  {
                    "NativeVisualCalculation": {
                      "Language": "dax",
                      "Expression": "\r\nvar _act = [DynamicMeasure]\r\nvar _prev = [dynamicMeasureprev]\r\nvar _dif = _act - _prev\r\nvar _pct = DIVIDE(_act - _prev, _prev)\r\n\r\nvar _act_form = IF([MetricName1] = \"Price (UAH)\",FORMAT(_act, \"0.00\"),  FORMAT(_act / 1000, \"# ##0.0\"))\r\nvar _prev_form = IF([MetricName1] = \"Price (UAH)\",FORMAT(_prev, \"0.00\"),  FORMAT(_prev / 1000, \"# ##0.0\"))\r\nvar _dif_form = IF([MetricName1] = \"Price (UAH)\",FORMAT(_dif, \"0.00\"),  FORMAT(_dif / 1000, \"# ##0.0\"))\r\n\r\nvar _metric_level = \r\nSWITCH([Metric],\r\n\"Actual\",  _act_form,\r\n\"PY\", _prev_form,\r\n\"Δ UAH\", _dif_form,\r\n\"Δ %\", FORMAT(_pct, \"0.0%\"))\r\n\r\nRETURN  \r\n// _metric_level\r\nSWITCH( TRUE(),\r\nISATLEVEL([Metric]), _metric_level,\r\nNOT ISATLEVEL([Metric]) && [MetricName1] = \"Price (UAH)\" \r\n    , NEXT([DynamicMeasure],1,COLUMNS) /  PREVIOUS([DynamicMeasure],1,COLUMNS,) ,\r\n FORMAT(_act / 1000, \"# ##0.0\"))",
                      "Name": "Show Value"
                    }
                  },
                  {
                    "NativeVisualCalculation": {
                      "Language": "dax",
                      "Expression": "\r\nvar _metric_color = \r\nSWITCH(TRUE(),\r\n[Metric] = \"Δ UAH\" && [Calc Value] > 0, \"#EA5656\",\r\n[Metric] = \"Δ UAH\" && [Calc Value] < 0, \"#58BE69\",\r\n[Metric] = \"Δ %\" && [Calc Value] > 0, \"#EA5656\",\r\n[Metric] = \"Δ %\" && [Calc Value] < 0, \"#58BE69\",\r\n\"#333333\"\r\n)\r\nRETURN _metric_color",
                      "Name": "Color Value"
                    }
                  }
                ]
              },
